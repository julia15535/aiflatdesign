# Скопируй этот файл в .env и подставь реальные значения (НЕ коммитить в git).
# На сервере .env лежит в /opt/aiflatdesigner/.env с правами 600.

# Telegram bot token (от @BotFather)
TG_BOT_TOKEN=

# OpenAI (через прокси gptproxy на сервере или напрямую к api.openai.com)
OPENAI_API_KEY=sk-proj-...
# В docker контейнере на сервере: http://host.docker.internal:8089/gpt
# Для локальной разработки можно оставить пустым (пойдёт напрямую на api.openai.com)
OPENAI_BASE_URL=

# Replicate API (для шагов 3-5)
REPLICATE_API_TOKEN=r8_...

# Admin Telegram ID — куда слать уведомления об ошибках (опционально)
ADMIN_TG_ID=

# Настройки
TEST_MODE=false
COST_LIMIT_USD=300
SIZE_TOLERANCE_PCT=15

# Модели OpenAI
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_QUALITY_CHECK_MODEL=gpt-5.4-mini
QUALITY_CHECK_ENABLED=true

# Где хранить базу данных и логи (в Docker: /app/data)
DATA_DIR=./data
